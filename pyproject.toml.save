[tool.poetry]
name = "penteam"
version = "0.1.0"
description = "Penteam: AI-Assisted Smart Contract Security System"
authors = ["Your Name <you@example.com>"]
readme = "README.md"
packages = [{ include = "src" }]

[tool.poetry.dependencies]
python = ">=3.10,<3.11"

ipython = "^8.12"

# Security tooling
slither-analyzer = "^0.10"
networkx = "^3.2"

# Vector + RAG stack
chromadb = "^0.4.22"
langchain = "^0.1.20"
langchain-community = "^0.0.38"
langchain-huggingface = "^0.0.6"

# Embeddings
sentence-transformers = "^2.6"

# Utilities
pypdf = "^3.17"
python-dotenv = "^1.0"

[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api
