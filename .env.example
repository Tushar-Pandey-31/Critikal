# ─── API Keys ────────────────────────────────────────────────
# Defaults route through xAI (Grok) and OpenAI (GPT) only — set BOTH
# to use the out-of-the-box config without overrides. ANTHROPIC_API_KEY
# and GOOGLE_API_KEY are only consulted if you override a *_MODEL_NAME
# env var to a claude-* or gemini-* model.
#
# Provider is auto-detected from model name: gpt-* → OpenAI, grok-* → xAI,
# claude-* → Anthropic, gemini-* → Google, openrouter/* → OpenRouter.
OPENAI_API_KEY=
XAI_API_KEY=
# Optional / opt-in providers
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ─── On-chain Recon (optional but recommended) ────────────────
# Without this, recon falls back to docs/NatSpec only and cannot inspect
# verified deployments. Used for read-only Etherscan + cast lookups.
ETHERSCAN_API_KEY=
# ETH_RPC_URL=                         # default: public archive node
# FORK_URL=                            # mainnet fork URL for sandbox_run

# ─── Web Search (optional but recommended) ────────────────────
# Lets the agent DISCOVER URLs (docs, exploit writeups, Etherscan
# pages, CVEs). Without this the agent can still fetch URLs it
# already knows via web_fetch, but cannot search.
#
# Get a key: https://platform.parallel.ai → Settings → API Keys
PARALLEL_API_KEY=
# WEB_SEARCH_PROVIDER=parallel         # leave unset to auto-detect from keys
# CRITIKAL_WEB_FETCH_ALLOW_PRIVATE=0   # set to 1 to allow fetching RFC1918 hosts

# ─── AUDIT MODE PRESET ───────────────────────────────────────
# fast | standard | deep | semantic_only
# Presets set sensible flag bundles. Individual flags below override.
AUDIT_MODE=standard

# ─── PIPELINE STAGE FLAGS ────────────────────────────────────
# Each stage is independently enabled/disabled. Accepts true/false/1/0/yes/no.
# Individual flags ALWAYS override the AUDIT_MODE preset.
SLITHER_ENABLED=true
SEMANTIC_DISCOVERY_ENABLED=false
ASSUMPTION_WORKER_ENABLED=true
EXECUTION_TRACE_ENABLED=true
DEPTH_WORKERS_ENABLED=true
JURY_ENABLED=false
GATE_ENABLED=true
TESTWRITER_ENABLED=true
FUZZ_GENERATOR_ENABLED=false
RAG_ENABLED=true
CHAIN_ANALYSIS_ENABLED=true
ETHERSCAN_ENABLED=true
DEPTH_ON_REJECTED=false

# ─── MODEL ROUTING ───────────────────────────────────────────
# Defaults below use xAI + OpenAI only. To use Claude or Gemini, set the
# corresponding env var explicitly and add the matching API key above.
#
# Agent (the top-level Claude-Code-style loop)
# AGENT_MODEL_NAME=grok-4-1-fast-reasoning
# AGENT_TEMPERATURE=0.0
# AGENT_FALLBACK_MODEL=                # used after primary model fails N retries;
                                       # defaults to a built-in cross-provider chain
                                       # (see FALLBACK_MODELS in src/agent/query_loop.py)

# Coordinator (legacy --legacy pipeline only)
# MODEL_NAME=gpt-5.4-mini

# Workers (default for all workers unless overridden)
# WORKER_MODEL_NAME=gpt-5.4-mini

# Per-worker overrides
# RECON_MODEL_NAME=gpt-5.4-mini
# ATTACK_MODEL_NAME=grok-4-1-fast-reasoning           # creative attacker
# ASSUMPTION_MODEL_NAME=grok-4-1-fast-reasoning       # zero-day discovery
# EXECUTION_TRACE_MODEL_NAME=gpt-5.4-mini
# TEST_WRITER_MODEL_NAME=grok-code-fast-1             # code-specialized
# FUZZ_MODEL_NAME=grok-code-fast-1
# DEPTH_MODEL_NAME=gpt-5.4-mini
# GATE_MODEL_NAME=gpt-5.4-mini

# Semantic discovery agents (InvariantHunter, EconomicAttacker, TrustBoundary, CrossContract)
# SEMANTIC_MODEL_NAME=gpt-5.4-mini

# Memory / sub-agent subsystem
# MEMORY_EXTRACT_MODEL=gpt-5.4-mini
# MEMORY_EXTRACT_INTERVAL=10           # turns between extractions
# DREAM_MODEL_NAME=gpt-5.4-mini
# COMPACT_MODEL_NAME=gpt-5.4-mini
# SUB_AGENT_MODEL_NAME=gpt-5.4-mini

# ─── JURY CONFIG ─────────────────────────────────────────────
# JURY_CONCURRENCY=5
# JURY_SKEPTIC_MODEL=gpt-5.5
# JURY_ATTACKER_MODEL=grok-4-1-fast-reasoning
# JURY_AUDITOR_MODEL=gpt-5.4-mini
# JURY_JUDGE_MODEL=grok-4-1-fast-reasoning

# ─── CONCURRENCY & BUDGET ────────────────────────────────────
# ATTACK_WORKER_CONCURRENCY=15
# TEST_WRITER_CONCURRENCY=3
# GATE_CONCURRENCY=10
# ASSUMPTION_CONFIDENCE_THRESHOLD=25
# ATTACK_CONFIDENCE_FLOOR=30           # findings below this are dropped pre-gate
# ATTACK_SPECULATIVE_FLOOR=50          # findings 30-49 routed to SPECULATIVE section
# EXEC_TRACE_CONFIDENCE_THRESHOLD=40
# PROMOTE_THRESHOLD=50                 # plausibility_score floor for TestWriter
# HOTSPOT_BUDGET=40                    # max hotspots scanned per run
# HOTSPOT_MIN_SCORE=20
# HOTSPOT_MIN_STRUCTURAL=10
# HOTSPOT_MIN_EXPLOIT=10
# SEMANTIC_FALLBACK_N=20
# SEMANTIC_FALLBACK_THRESHOLD=10

# ─── TIMEOUTS (seconds) ──────────────────────────────────────
# CLONE_TIMEOUT=300
# SUBMODULE_TIMEOUT=600
# WORKER_LLM_TIMEOUT=180
# ATTACK_WORKER_LLM_TIMEOUT=300
# ASSUMPTION_WORKER_LLM_TIMEOUT=300
# EXECUTION_TRACE_LLM_TIMEOUT=300
# DEPTH_WORKER_LLM_TIMEOUT=300
# SEMANTIC_LLM_TIMEOUT=300
# ECONOMIC_LLM_TIMEOUT=300
# TRUST_LLM_TIMEOUT=300
# CROSS_CONTRACT_LLM_TIMEOUT=300
# TEST_WRITER_LLM_TIMEOUT=600
# GATE_EVALUATE_TIMEOUT=120
# COORDINATOR_SYNTHESIS_TIMEOUT=180

# ─── LLM TRANSPORT & RETRIES ─────────────────────────────────
# WORKER_LLM_TRANSPORT=rest            # rest | grpc (gemini only)
# WORKER_LLM_MAX_RETRIES=0
# OPENROUTER_MAX_TOKENS=16384

# ─── RATE LIMITING & KEY POOL ────────────────────────────────
# KEY_COOLDOWN_SECONDS=60              # cooldown after a key hits 429
# RATE_LIMIT_TIER=free                 # free | tier1 | tier2 | tier3 | tier4
# RATE_LIMIT_RPM_OVERRIDE=             # override requests/minute
# RATE_LIMIT_TPM_OVERRIDE=             # override tokens/minute
# RATE_LIMIT_RPD_OVERRIDE=             # override requests/day

# ─── HARNESS / SANDBOX ───────────────────────────────────────
# HARNESS_MODE=auto                    # auto | foundry | hardhat
# CRITIKAL_SANDBOX=auto                # auto | bwrap | sandbox-exec | none

# ─── OPTIONAL: User-defined hooks & deployment data ──────────
# CRITIKAL_SETTINGS=                   # path to hooks settings.json
# CONTRACT_ADDRESSES_JSON=             # path to a JSON of {name: 0xaddr} for cast lookups
# CRITIKAL_GIT_USE_SSH=                # set to 1 to clone GitHub repos over SSH (for private repos)
