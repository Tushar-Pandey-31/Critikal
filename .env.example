# Google API Keys
GOOGLE_API_KEY=your_key_here
# Optional: Comma-separated list for rotation
GOOGLE_API_KEYS=key1,key2,key3

# xAI API Key (for Grok models)
XAI_API_KEY=your_grok_key_here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your_claude_key_here

# Etherscan API Key (for Recon on-chain signals)
ETHERSCAN_API_KEY=your_key_here

# Model Selection
MODEL_NAME=gemini-2.5-pro
RECON_MODEL_NAME=gemini-2.5-flash
ATTACK_MODEL_NAME=grok-3
TEST_WRITER_MODEL_NAME=claude-3.5-sonnet
WORKER_MODEL_NAME=gemini-2.5-flash

# Advanced Settings
ANONYMIZED_TELEMETRY=false
TEST_WRITER_LLM_TIMEOUT=600
ATTACK_WORKER_LLM_TIMEOUT=300
WORKER_LLM_TRANSPORT=rest